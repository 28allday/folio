pkgname=folio
pkgver=0.1.0
pkgrel=1
pkgdesc="Omarchy's file manager: airy, keyboard-first, and following the theme"
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-multimedia' 'qt6-wayland' 'xdg-utils' 'zlib')
optdepends=(
  'qt6-webengine: PDF previews (Qt PDF)'
  'ffmpegthumbnailer: video thumbnails'
  'papers: PDF thumbnails'
  'glycin: HEIC, JPEG XL and other image thumbnails'
  'gvfs: browsing tailnet machines over SFTP'
  'tailscale: listing tailnet machines'
  'dropbox-cli: Dropbox sync status'
)
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/folio "$pkgdir/usr/bin/folio"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/folio.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/folio.svg"
  install -Dm644 "$startdir/folio.desktop" "$pkgdir/usr/share/applications/folio.desktop"
}
